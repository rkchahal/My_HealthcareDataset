    <worksheet name='Relation between Stay and Biiling'>
      <layout-options>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>3. How does length of stay (Discharge Date – Admission Date) affect billing amount across hospitals?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Purpose:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Reveal whether longer stays are consistently associated with higher bills, and if that varies by hospital.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
