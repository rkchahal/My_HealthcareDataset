    <worksheet name='Average Billing based on Medical Condition and Gender'>
      <layout-options>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>1. How does the average billing amount vary by medical condition and gender?</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Purpose:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'> Identify cost differences in treating various conditions across male and female patients.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
